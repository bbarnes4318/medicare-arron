{
  "manifest_version": 3,
  "name": "Medicare Form Data Capture",
  "version": "1.0",
  "description": "Captures form data and sends it to the local portal for storage.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["*://lowinsurancecost.com/*", "http://localhost:5000/*"],
  "content_scripts": [
    {
      "matches": ["*://lowinsurancecost.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
