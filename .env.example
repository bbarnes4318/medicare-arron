# Proxy Configuration (Decodo)
PROXY_HOST=us.decodo.com
PROXY_PORT=10000
PROXY_USERNAME=your_decodo_username
PROXY_PASSWORD=your_decodo_password

# IPRoyal Configuration (for proxy_server.py)
IPROYAL_HOST=geo.iproyal.com
IPROYAL_PORT=12321
IPROYAL_USER=your_iproyal_username
IPROYAL_PASS=your_iproyal_password
# Or use base password for dynamic session generation
# IPROYAL_PASS_BASE=Topproducer2026

# Flask Configuration
SECRET_KEY=your_secret_key_here

# Google Sheets (Optional)
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=
